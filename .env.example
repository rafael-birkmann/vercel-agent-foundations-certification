# Copy to .env.local (or run `vercel env pull .env.local`) and fill in values.
# Never commit .env.local. None of these may use a NEXT_PUBLIC_ prefix.

# --- Store API (required) ---------------------------------------------------
# Vercel deployment-protection bypass for the store API. Sent server-side only.
BYPASS_SECRET=
# Optional. Defaults to https://vercel-agentic-swag-store-api.vercel.app/api
API_BASE_URL=

# --- Vercel AI Gateway + Vercel Sandbox auth --------------------------------
# Local dev: `vercel env pull .env.local` writes a short-lived OIDC token
# (expires after ~12h; re-run the command). On Vercel it is provided automatically.
# Used by both AI Gateway (model calls) and Vercel Sandbox (admin agent).
VERCEL_OIDC_TOKEN=
# Optional alternative for AI Gateway only (also add it in the Vercel project).
AI_GATEWAY_API_KEY=

# --- Optional overrides -------------------------------------------------------
# Any AI Gateway model id that supports tool calling.
SHOPPING_AGENT_MODEL=anthropic/claude-haiku-5.5
ADMIN_AGENT_MODEL=anthropic/claude-sonnet-5.5
# Name of the persistent admin sandbox (memory + computation).
ADMIN_SANDBOX_NAME=ship-it-shop-admin
# Set to 1 to make the first "file return" attempt fail, to demo durable retries.
RETURN_FLOW_SIMULATE_FAILURE=
# Public site URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
